"use client";

import { useState, useEffect } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { Breadcrumbs } from "@/components/layout/breadcrumbs";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { useApp } from "@/contexts/AppContext";
import { useToast } from "@/components/ui/toast";
import { generateId } from "@/lib/storage";
import { Check, ChevronLeft, ChevronRight } from "lucide-react";

const steps = ["Brand Identity", "Visual Identity", "Target Audience", "Review"];

const industries = [
  { value: "tech", label: "Technology" },
  { value: "fnb", label: "Food & Beverage" },
  { value: "fashion", label: "Fashion" },
  { value: "finance", label: "Finance" },
  { value: "healthcare", label: "Healthcare" },
  { value: "education", label: "Education" },
  { value: "other", label: "Other" },
];

export default function BrandSetupPage() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const isOnboarding = searchParams.get("onboarding") === "true";
  const { addBrand, brands } = useApp();
  const { toast } = useToast();
  const [step, setStep] = useState(0);
  const [form, setForm] = useState({
    brandName: "",
    tagline: "",
    industry: "",
    description: "",
    primaryColor: "#c2ef4e",
    toneStyle: "formal",
  });

  // Redirect if already have brands during onboarding
  useEffect(() => {
    if (isOnboarding && brands.length > 0) {
      router.replace("/dashboard/executive-summary");
    }
  }, [isOnboarding, brands, router]);

  const update = (field: string, value: string) => setForm((f) => ({ ...f, [field]: value }));

  const isLast = step === steps.length - 1;

  const handleSave = () => {
    addBrand({
      id: generateId(),
      brandName: form.brandName || "New Brand",
      tagline: form.tagline,
      colors: { primary: form.primaryColor },
      industry: industries.find((i) => i.value === form.industry)?.label || form.industry,
      targetDemographic: { 
        ageRange: form.description || "25-45", 
        location: "Indonesia", 
        gender: "all", 
        interests: [] 
      },
      brandPersonality: [form.toneStyle],
    });
    toast("Brand created successfully!", "success");
    router.push(isOnboarding ? "/dashboard/executive-summary" : "/dashboard/brands");
  };
      targetDemographic: { ageRange: "", location: "", gender: "all", interests: [] },
      brandPersonality: [form.toneStyle],
    });
    toast("Brand created successfully!", "success");
    router.push("/dashboard/brands");
  };

  return (
    <div className="max-w-2xl mx-auto space-y-8">
      <Breadcrumbs items={[{ label: "Brand", href: "/dashboard/brands" }, { label: "Setup" }]} />

      <div>
        <h1 className="text-[30px] font-medium leading-[1.2]">Brand DNA Setup</h1>
        <p className="text-[16px] text-on-dark-muted mt-1">Define who your brand is — this foundation powers all other modules</p>
      </div>

      <div className="flex items-center gap-2">
        {steps.map((s, i) => (
          <div key={s} className="flex items-center gap-2 flex-1">
            <div className={`flex items-center gap-2 ${i <= step ? "text-accent-lime" : "text-on-dark-muted/50"}`}>
              <div className={`w-8 h-8 rounded-full flex items-center justify-center text-[14px] font-semibold transition-all ${
                i < step ? "bg-accent-lime text-ink-deep" :
                i === step ? "border-2 border-accent-lime text-accent-lime" :
                "border-2 border-hairline-violet text-on-dark-muted/50"
              }`}>
                {i < step ? <Check size={16} /> : i + 1}
              </div>
              <span className="text-[14px] leading-[1.43] hidden sm:inline">{s}</span>
            </div>
            {i < steps.length - 1 && <div className="flex-1 h-px bg-hairline-violet/50" />}
          </div>
        ))}
      </div>

      <div className="animate-fade-slide-right">
        {step === 0 && (
          <div className="space-y-4">
            <Input label="Brand Name" placeholder="e.g. Sentri" value={form.brandName}
              onChange={(e) => update("brandName", e.target.value)} />
            <Input label="Tagline" placeholder="e.g. Monitor your brand in real-time" value={form.tagline}
              onChange={(e) => update("tagline", e.target.value)} />
            <Select label="Industry" options={industries} value={form.industry}
              onChange={(e) => update("industry", e.target.value)} />
          </div>
        )}

        {step === 1 && (
          <div className="space-y-4">
            <div className="flex flex-col gap-2">
              <label className="text-[16px] font-medium leading-[1.5] text-on-primary/80">Primary Color</label>
              <div className="flex items-center gap-3">
                <input type="color" value={form.primaryColor}
                  onChange={(e) => update("primaryColor", e.target.value)}
                  className="w-12 h-12 rounded-md border border-hairline-violet cursor-pointer bg-transparent" />
                <span className="text-[14px] text-on-dark-muted">{form.primaryColor}</span>
              </div>
            </div>
            <Select label="Communication Style" options={[
              { value: "formal", label: "Formal" },
              { value: "casual", label: "Casual" },
              { value: "authoritative", label: "Authoritative" },
              { value: "energetic", label: "Energetic" },
              { value: "humorous", label: "Humorous" },
            ]} value={form.toneStyle} onChange={(e) => update("toneStyle", e.target.value)} />
          </div>
        )}

        {step === 2 && (
          <div className="space-y-4">
            <Input label="Target Age Range" placeholder="e.g. 25-45" value={form.description}
              onChange={(e) => update("description", e.target.value)} />
            <Input label="Target Location" placeholder="e.g. Indonesia, Singapore" />
            <Input label="Target Interests" placeholder="e.g. Technology, Marketing, SaaS" />
          </div>
        )}

        {step === 3 && (
          <div className="space-y-4 p-6 rounded-lg bg-surface-night border border-hairline-violet">
            <h3 className="text-[24px] font-semibold leading-[1.25]">Review Your Brand</h3>
            <div className="space-y-3 text-[16px]">
              <div className="flex justify-between"><span className="text-on-dark-muted">Brand Name</span><span>{form.brandName || "—"}</span></div>
              <div className="flex justify-between"><span className="text-on-dark-muted">Tagline</span><span>{form.tagline || "—"}</span></div>
              <div className="flex justify-between"><span className="text-on-dark-muted">Industry</span><span>{industries.find((i) => i.value === form.industry)?.label || "—"}</span></div>
              <div className="flex justify-between"><span className="text-on-dark-muted">Color</span><span className="flex items-center gap-2"><span className="w-4 h-4 rounded" style={{ background: form.primaryColor }} />{form.primaryColor}</span></div>
              <div className="flex justify-between"><span className="text-on-dark-muted">Tone</span><span>{form.toneStyle}</span></div>
            </div>
          </div>
        )}
      </div>

      <div className="flex items-center justify-between pt-4 border-t border-hairline-violet/50">
        <Button variant="ghost" onClick={() => setStep(Math.max(0, step - 1))} disabled={step === 0}>
          <ChevronLeft size={16} /> Back
        </Button>
        <div className="flex items-center gap-2">
          <button className="text-[14px] leading-[1.43] text-on-dark-muted hover:text-on-primary transition-colors">Skip</button>
          <Button variant={isLast ? "inverted" : "primary"} onClick={() => {
            if (isLast) { handleSave(); } else setStep(Math.min(steps.length - 1, step + 1));
          }}>
            {isLast ? "Save Brand" : "Next"} {!isLast && <ChevronRight size={16} />}
          </Button>
        </div>
      </div>
    </div>
  );
}
